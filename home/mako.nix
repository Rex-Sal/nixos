{
  services.mako = {
    enable = true;

    settings = {
      anchor = "top-right";
      width = 400;
      height = 100;
      margin = 10;
      padding = 15;

      border-size = 2;
      border-radius = 8;

      background-color = "#1e1e2e";
      text-color = "#cdd6f4";
      border-color = "#89b4fa";

      font = "JetBrains Mono 10";

      default-timeout = 5000;
      ignore-timeout = false;

      max-visible = 5;
      max-history = 20;

      icons = true;
      max-icon-size = 32;

      markup = true;
      actions = true;
    };
  };
}

